{
  "expo": {
    "name": "Trainly",
    "slug": "trainly-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "trainly",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.trainly.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "O Trainly usa sua localização para registrar a rota e a distância das suas corridas."
      }
    },
    "android": {
      "package": "com.trainly.app",
      "adaptiveIcon": {
        "backgroundColor": "#0a0b0f",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Trainly usa sua localização para registrar a rota e a distância das suas corridas."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0b0f",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "android": {
            "backgroundColor": "#0a0b0f",
            "image": "./assets/splash-icon-android.png",
            "imageWidth": 240
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Trainly usa suas fotos pra você escolher uma foto de perfil.",
          "cameraPermission": "O Trainly usa a câmera pra você tirar uma foto de perfil na hora."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c3a83ea3-9fe2-41cb-bee6-8cd85e057e9c"
      }
    }
  }
}
